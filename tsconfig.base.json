{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "jsx": "preserve",
    "baseUrl": ".",
    "paths": {
      "@atlas/domain": ["src/domain/index.ts"],
      "@atlas/domain/*": ["src/domain/*"],
      "@atlas/application": ["src/application/index.ts"],
      "@atlas/application/*": ["src/application/*"],
      "@atlas/database": ["src/database/index.ts"],
      "@atlas/database/*": ["src/database/*"],
      "@atlas/utils": ["src/utils/index.ts"],
      "@atlas/utils/*": ["src/utils/*"],
      "@atlas/web/*": ["src/*"],
      "@/*": ["src/*"]
    }
  }
}
